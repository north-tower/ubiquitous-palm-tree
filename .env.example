# Base URL of the Nest API (server-side proxy in app/backend/[...path]/route.ts).
# Production: public API host. Local dev: http://localhost:5600 or http://localhost:3000
API_URL=https://bot.techfindconsulting.africa

# Public UI URL (set on the Nest API as TENANT_PORTAL_APP_URL and CORS_ORIGIN if needed).
# PUBLIC_UI_URL=https://whatsappdesk.techfindconsulting.africa

# Let's Encrypt (deploy/certbot/issue-cert.sh on the server)
CERTBOT_EMAIL=ops@techfindconsulting.africa
CERTBOT_DOMAIN=whatsappdesk.techfindconsulting.africa

# Optional: expose UI directly on localhost for debugging (not used when nginx is enabled)
# UI_PORT=3001
